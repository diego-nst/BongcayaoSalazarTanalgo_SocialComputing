   "source": [
    "#inserting data from 1 dataset to the next\n",
    "estimated_owners = []\n",
    "prices = []\n",
    "last_game = \"\"\n",
    "estimate = \"\"\n",
    "price = 0\n",
    "story_rich=[]\n",
    "narrative=[]\n",
    "choices_matter=[]\n",
    "to_append = [False, False, False]\n",
    "for i in range (len(filtered_reviews)):\n",
    "    game = filtered_reviews.iloc[i,1] #sometimes its 1, sometimes its 2,,, idk why \n",
    "    if game != last_game:\n",
    "        estimate = narrative_games.loc[narrative_games[\"AppID\"]==game, \"Release date\"].iloc[0]\n",
    "        #for some reason realease date is the header for estimated owners dont ask me\n",
    "        game_tags = narrative_games.loc[narrative_games[\"AppID\"]==game, \"Tags\"].iloc[0]\n",
    "        to_append[0] = \"Story Rich\" in game_tags\n",
    "        to_append[1] = \"Narrative\" in game_tags\n",
    "        to_append[2] = \"Choices Matter\" in game_tags\n",
    "        #same here,, required age = price\n",
    "        price = narrative_games.loc[narrative_games[\"AppID\"]==game, \"Required age\"].iloc[0]\n",
    "\n",
    "    estimated_owners.append(estimate)\n",
    "    story_rich.append(to_append[0])\n",
    "    narrative.append(to_append[1])\n",
    "    choices_matter.append(to_append[2])\n",
    "    prices.append(price)\n",
    "    last_game = game    \n",
    "\n",
    "\n",
    "filtered_reviews[\"estimated_owners\"] = estimated_owners \n",
    "filtered_reviews[\"story_rich\"] = story_rich\n",
    "filtered_reviews[\"narrative\"] = narrative \n",
    "filtered_reviews[\"choices_matter\"] = choices_matter \n",
    "filtered_reviews[\"price\"] = prices\n",
    "\n",
    "estimated_owners = []\n",
    "prices = []\n",
    "last_game = \"\"\n",
    "estimate = \"\"\n",
    "price = 0\n",
    "story_rich=[]\n",
    "narrative=[]\n",
    "choices_matter=[]\n",
    "filtered_reviews.head()"
   ]

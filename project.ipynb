    "sentiment_analysis = lambda doc: sia.polarity_scores(doc.text)\n",
    "nlp_with_sentiment = spacy.load(\"en_core_web_sm\")\n",
    "Doc.set_extension(\"sentiment\", getter=sentiment_analysis, force=True)\n",
    "\n",
    "review_docs = nlp_with_sentiment.pipe(lemmatized_reviews, batch_size=32)\n",
    "i=0\n",
    "com_sent = []\n",
    "pos_sent = []\n",
    "neg_sent = []\n",
    "neu_sent = []\n",
    "for i, doc in enumerate(review_docs, start=1):\n",
    "    sentiment = doc._.sentiment\n",
    "    com_sent.append(sentiment['compound'])\n",
    "    pos_sent.append(sentiment['pos'])\n",
    "    neg_sent.append(sentiment['neg'])\n",
    "    neu_sent.append(sentiment['neu'])\n",
    "    i+=1\n",
    "    if(i%1000==0):\n",
    "        clear_output(wait=True)\n",
    "        print(str(i)+'/'+str(len(filtered_reviews)))\n",
    "filtered_reviews['com_sent'] = com_sent\n",
    "filtered_reviews['pos_sent'] = pos_sent\n",
    "filtered_reviews['neg_sent'] = neg_sent\n",
    "filtered_reviews['neu_sent'] = neu_sent\n",
    "\n",
    "filtered_reviews.head()"

   "source": [
    "from nltk.corpus import stopwords\n",
    "from nltk.stem import WordNetLemmatizer\n",
    "lemmatizer = WordNetLemmatizer()\n",
    "\n",
    "word_tokens = [ (str(review)).split() for review in filtered_reviews['review_text']]\n",
    "\n",
    "stop_words = set(stopwords.words('english'))\n",
    "stop_words.add('us')\n",
    "\n",
    "lemmatized_reviews = []\n",
    "for tokens in word_tokens:\n",
    "    lemmatized_reviews.append([lemmatizer.lemmatize(token) for token in tokens if token not in stop_words or token=='not'])\n",
    "\n",
    "lemmatized_reviews = [\" \".join(review) for review in lemmatized_reviews]\n",
    "\n",
    "filtered_reviews[\"lemmatized_reviews\"] = lemmatized_reviews\n",
    "filtered_reviews"
   ]
  },

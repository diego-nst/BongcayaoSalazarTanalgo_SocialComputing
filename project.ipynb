    "#filters for ascii characters\n",
    "filter_ascii = filtered_reviews[\"review_text\"].replace(to_replace=r'[^\\x00-\\x7f]', value='', regex=True)\n",
    "\n",
    "#removes new lines\n",
    "remove_newline = filter_ascii.replace(to_replace=r'\\d', value='', regex=True)\n",
    "\n",
    "#removes certain characters used in reviews\n",
    "remove_otherchars = remove_newline.replace(to_replace=r'[,()*/\"1234567890+|]', value='', regex=True)\n",
    "\n",
    "#removes punctuations\n",
    "replace_punctuations = remove_otherchars.replace(to_replace=r'[.!?]+', value = ' | ', regex=True)\n",
    "\n",
    "#remove dashes not used to hyphenate words\n",
    "remove_nonhyphen_dashes = replace_punctuations.replace(to_replace=r'- | -', value=' ', regex=True)\n",
    "\n",
    "#remove extra whitespace\n",
    "remove_extra_whitespace = remove_nonhyphen_dashes.replace(to_replace=r' +', value=' ', regex=True)\n",
    "\n",
    "# assign cleaned entries back to the data frame\n",
    "new = remove_extra_whitespace\n",
    "filtered_reviews['review_text'] = new\n",
    "\n",
    "# apply lowercasing\n",
    "filtered_reviews['review_text'] = filtered_reviews['review_text'].str.lower()\n",
    "filtered_reviews\n",
    "\n",
    "print(filtered_reviews)"
   ]
